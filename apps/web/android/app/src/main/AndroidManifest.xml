<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->

    <!-- Google Drive sync, AI providers, and the one-time handwriting model download. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Paper-feel haptic grain and confirmation ticks. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Audio notes: the web layer calls getUserMedia(); Capacitor's BridgeWebChromeClient then asks
      for RECORD_AUDIO at runtime and grants the WebView's AUDIO_CAPTURE request. It also requests
      MODIFY_AUDIO_SETTINGS and only grants when *both* are granted, so that (install-time)
      permission must be declared here too.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      No CAMERA permission on purpose: <input capture> launches the system camera app through
      ACTION_IMAGE_CAPTURE, which needs no permission as long as the app does not declare CAMERA.
    -->

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      No cloud backup: the WebView storage holds the API-key encryption key next to the keys it
      encrypts (res/xml/data_extraction_rules.xml, security review SR-03). Android 12+ still moves
      everything to a new phone with device-to-device transfer.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          On-device AI: LiteRT-LM runs models on the GPU through the vendor's OpenCL driver, which
          apps targeting Android 12+ may only load when declared. Optional: phones without it fall
          back to the CPU (see app/inkwright/ai/LiteRtEngine.kt).
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!--
          Foldables (Razr Fold): the activity is resizeable and handles every configuration change a
          fold/unfold, rotation, display move or dark-mode switch causes, so the WebView (and the
          note being written) is never torn down and reloaded.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|colorMode"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              "Open with Inkwright" and "Share to Inkwright" for PDFs, images and text. The plugin
              (InkwrightNativePlugin → files/IncomingFiles.kt) copies the content into the app's
              cache and hands it to the web layer, which imports it like the library's Open file.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
            </intent-filter>
            <!--
              Deep links (docs/API.md § Links): inkwright://new?title=…&text=…, inkwright://open?note=…,
              inkwright://search?q=…, inkwright://capture?url=… — for Shortcuts-style automation
              (Tasker, launchers, other apps). Capacitor's App plugin passes them to the web layer
              as appUrlOpen (developer/deeplinks.ts).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inkwright" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
