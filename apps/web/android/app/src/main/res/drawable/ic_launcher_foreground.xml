<?xml version="1.0" encoding="utf-8"?>
<!--
  Inkstone mark on the 108dp adaptive-icon canvas: a light ink drop with a slit (the nib cut),
  and a cinnabar seal dot bottom-right. Drawn in the favicon's 64-unit space and mapped onto the
  72dp visible area (scale 1.125, offset 18dp); everything stays inside the 66dp safe circle.
  The background layer is the slate colour, so masks of any shape give the rounded-square look.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.125"
        android:scaleY="1.125"
        android:translateX="18"
        android:translateY="18">
        <!-- drop, with the slit cut out (even-odd) so the slate shows through -->
        <path
            android:fillColor="@color/inkstone_paper"
            android:fillType="evenOdd"
            android:pathData="M32,10c7,9 12,17 12,25a12,12 0,0 1,-24 0c0,-8 5,-16 12,-25z M30.5,25a1.5,1.5 0,0 1,3 0v17a1.5,1.5 0,0 1,-3 0z" />
        <!-- cinnabar seal dot -->
        <path
            android:fillColor="@color/inkstone_cinnabar"
            android:pathData="M47,48m-6,0a6,6 0,1 0,12 0a6,6 0,1 0,-12 0" />
    </group>
</vector>
