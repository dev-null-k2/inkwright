<?xml version="1.0" encoding="utf-8"?>
<!--
  Inkwright mark on the 108dp adaptive-icon canvas: a Duan inkstone seen from above. The background
  layer is the stone itself; on it, the well of wet ink with its sheen, the grinding face, and one
  jade stone-eye. Drawn in the favicon's 64-unit space and mapped onto the 72dp visible area
  (scale 1.125, offset 18dp); everything stays inside the 66dp safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.125"
        android:scaleY="1.125"
        android:translateX="18"
        android:translateY="18">
        <!-- ink well (umi) -->
        <path
            android:fillColor="@color/inkwright_well"
            android:pathData="M14,19a18,8.5 0,1 0,36 0a18,8.5 0,1 0,-36 0z" />
        <!-- wet-ink sheen -->
        <path
            android:strokeColor="@color/inkwright_sheen"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:pathData="M21,16.5c3.8,-2.8 8.8,-3.9 14.5,-3.3" />
        <!-- grinding face (oka) -->
        <path
            android:fillColor="@color/inkwright_face"
            android:pathData="M23,31h18a9,9 0,0 1,9 9v6a9,9 0,0 1,-9 9h-18a9,9 0,0 1,-9 -9v-6a9,9 0,0 1,9 -9z" />
        <!-- jade stone-eye: faint ring, eye, dark core -->
        <path
            android:strokeColor="@color/inkwright_jade_ring"
            android:strokeWidth="1.6"
            android:pathData="M43,45m-7,0a7,7 0,1 0,14 0a7,7 0,1 0,-14 0" />
        <path
            android:fillColor="@color/inkwright_jade"
            android:pathData="M43,45m-4.5,0a4.5,4.5 0,1 0,9 0a4.5,4.5 0,1 0,-9 0" />
        <path
            android:fillColor="@color/inkwright_slate"
            android:pathData="M43,45m-1.8,0a1.8,1.8 0,1 0,3.6 0a1.8,1.8 0,1 0,-3.6 0" />
    </group>
</vector>
