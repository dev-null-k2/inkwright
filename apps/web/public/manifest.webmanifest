{
  "name": "Inkstone",
  "short_name": "Inkstone",
  "description": "Handwriting notes that feel like paper, on every device, with your own AI.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#E8E5EA",
  "theme_color": "#2E2533",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"], "image/*": [".png", ".jpg", ".jpeg", ".webp", ".heic", ".heif"], "text/plain": [".txt"], "text/markdown": [".md", ".markdown"] } }
  ],
  "protocol_handlers": [
    { "protocol": "web+inkstone", "url": "./?link=%s" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "files", "accept": ["application/pdf", ".pdf", "image/*", "text/plain", ".txt", "text/markdown", ".md"] }]
    }
  },
  "shortcuts": [
    { "name": "New note", "url": "./#new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
