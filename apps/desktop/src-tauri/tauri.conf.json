{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwright",
  "version": "1.0.0",
  "identifier": "app.inkwright",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @inkwright/web -- --mode desktop",
    "beforeBuildCommand": "npm run web && npm run sidecar"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkwright",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval' https://accounts.google.com",
        "style-src": "'self' 'unsafe-inline' https://accounts.google.com",
        "img-src": "'self' data: blob: https://*.googleusercontent.com",
        "font-src": "'self' data:",
        "connect-src": "* data: blob: ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: data:",
        "frame-src": "https://accounts.google.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Handwriting notes with bring-your-own AI",
    "longDescription": "Inkwright is a handwriting-first notes app: paper feel, plain files, and the AI and sync you choose.",
    "copyright": "Inkwright contributors",
    "license": "Apache-2.0",
    "homepage": "https://github.com/dev-null-k2/inkwright",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/inkwright-mcp"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "Open a PDF to read, annotate, fill and sign it in Inkwright",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "section": "editors" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["inkwright"] }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/dev-null-k2/inkwright/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
