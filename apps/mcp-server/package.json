{
  "name": "@inkstone/mcp-server",
  "version": "1.0.0",
  "description": "MCP server, A2A agent and always-on routine runner for an Inkstone notes vault.",
  "type": "module",
  "bin": {
    "inkstone-mcp": "dist/index.js",
    "inkstone-agent": "dist/agent.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "tsx --import ./scripts/raw-hooks.mjs src/index.ts",
    "agent": "tsx --import ./scripts/raw-hooks.mjs src/agent-cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@inkstone/ai": "*",
    "@inkstone/core": "*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "ajv": "^8.20.0",
    "@inkstone/plugin-api": "*"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "zod": "^4.6.7",
    "pdf-lib": "^1.17.1"
  },
  "license": "Apache-2.0"
}
