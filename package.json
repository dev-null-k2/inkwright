{
  "name": "inkwright",
  "private": true,
  "version": "1.0.0",
  "description": "Inkwright — paper-feel handwriting notes for every device, with bring-your-own-AI agents.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @inkwright/web",
    "build": "npm run build -w @inkwright/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "e2e": "npm run build -w @inkwright/web && npm run e2e -w @inkwright/web",
    "e2e:all": "npm run e2e:all -w @inkwright/web",
    "e2e:android": "npm run e2e:android -w @inkwright/web",
    "evals": "vitest run --project evals",
    "eval:local": "tsx --import ./packages/ai/evals/raw-imports.mjs packages/ai/evals/run-local-model.ts",
    "build:preview": "npm run build:single -w @inkwright/web && node apps/web/scripts/artifact.mjs",
    "art": "node --experimental-strip-types scripts/brand/readme-art.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@4.0.0 --omit dev --output-format JSON --spec-version 1.6 --output-file sbom.cdx.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "jsdom": "^30.1.3",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
