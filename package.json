{
  "name": "inkstone",
  "private": true,
  "version": "1.0.0",
  "description": "Inkstone \u2014 paper-feel handwriting notes for every device, with bring-your-own-AI agents.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @inkstone/web",
    "build": "npm run build -w @inkstone/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "npm run build -w @inkstone/web && npm run e2e -w @inkstone/web",
    "e2e:all": "npm run e2e:all -w @inkstone/web",
    "e2e:android": "npm run e2e:android -w @inkstone/web",
    "evals": "vitest run --project evals",
    "build:preview": "npm run build:single -w @inkstone/web && node apps/web/scripts/artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "jsdom": "^30.1.3",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
