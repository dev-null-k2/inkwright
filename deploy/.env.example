# Inkstone appliance settings (docs/ENTERPRISE.md). Copy to deploy/.env and edit.

# The address people use (behind your TLS terminator). Required.
INKSTONE_PUBLIC_URL=https://notes.example.com
# Where the web container listens on this host. Put a TLS proxy or ingress in front of it.
INKSTONE_BIND=127.0.0.1
INKSTONE_PORT=8080

# Sign-in for MCP and A2A — OpenID Connect / OAuth 2.1 (recommended):
INKSTONE_OAUTH_ISSUER=https://login.example.com/realms/staff
INKSTONE_OAUTH_AUDIENCE=https://notes.example.com/mcp
# INKSTONE_OAUTH_JWKS_URL=https://login.example.com/realms/staff/protocol/openid-connect/certs
# …or a bearer token instead (generate with: openssl rand -hex 32):
# INKSTONE_MCP_TOKEN=

# The administrator's AI policy (users can tighten, never loosen). Start from managed-policy.example.json.
INKSTONE_MANAGED_POLICY=./managed-policy.example.json

# WebDAV users for the app's sync (create with: htpasswd -B -c deploy/webdav.htpasswd alice).
INKSTONE_WEBDAV_HTPASSWD=./webdav.htpasswd

# The server's own AI. Default: Ollama inside the appliance (start with --profile ollama).
INKSTONE_AI_PROVIDER=ollama
INKSTONE_AI_MODEL=qwen2.5:7b-instruct
INKSTONE_AI_BASE_URL=http://ollama:11434/v1
INKSTONE_AI_ON_PREMISES=1
INKSTONE_A2A=1

# Image names, for a registry you control.
# INKSTONE_IMAGE_PREFIX=registry.example.com/inkstone
# INKSTONE_VERSION=1.0.0
