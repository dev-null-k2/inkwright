# Inkwright appliance settings (docs/ENTERPRISE.md). Copy to deploy/.env and edit.

# The address people use (behind your TLS terminator). Required.
INKWRIGHT_PUBLIC_URL=https://notes.example.com
# Where the web container listens on this host. Put a TLS proxy or ingress in front of it.
INKWRIGHT_BIND=127.0.0.1
INKWRIGHT_PORT=8080

# Sign-in for MCP and A2A — OpenID Connect / OAuth 2.1 (recommended):
INKWRIGHT_OAUTH_ISSUER=https://login.example.com/realms/staff
INKWRIGHT_OAUTH_AUDIENCE=https://notes.example.com/mcp
# INKWRIGHT_OAUTH_JWKS_URL=https://login.example.com/realms/staff/protocol/openid-connect/certs
# …or a bearer token instead (generate with: openssl rand -hex 32):
# INKWRIGHT_MCP_TOKEN=

# The administrator's AI policy (users can tighten, never loosen). Start from managed-policy.example.json.
INKWRIGHT_MANAGED_POLICY=./managed-policy.example.json

# WebDAV users for the app's sync (create with: htpasswd -B -c deploy/webdav.htpasswd alice).
INKWRIGHT_WEBDAV_HTPASSWD=./webdav.htpasswd

# The server's own AI. Default: Ollama inside the appliance (start with --profile ollama).
INKWRIGHT_AI_PROVIDER=ollama
INKWRIGHT_AI_MODEL=qwen2.5:7b-instruct
INKWRIGHT_AI_BASE_URL=http://ollama:11434/v1
INKWRIGHT_AI_ON_PREMISES=1
INKWRIGHT_A2A=1

# Image names, for a registry you control.
# INKWRIGHT_IMAGE_PREFIX=registry.example.com/inkwright
# INKWRIGHT_VERSION=1.0.0
